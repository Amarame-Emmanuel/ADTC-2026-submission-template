# Model weights are fetched by scripts/fetch_models.py, never committed.
models/
*.gguf
*.onnx
*.bin
*.safetensors

# Built artifacts
index/
corpus/raw/*
!corpus/raw/.gitkeep
corpus/processed/

# Third-party bulk archives (Infonet-Biovision offline export, ~1.5 GB).
# Licensed CC BY-NC-SA 3.0 - fetched by the operator, never redistributed here.
corpus/external/*
!corpus/external/.gitkeep

# Benchmark output: aggregated results ARE committed (bench/results/*.json),
# raw per-run traces are not.
bench/traces/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Stray toolchains. A full Oracle JDK (373 MB) was found inside
# agbe/ui/static/; nothing in this project uses Java - the UI is a single
# self-contained HTML file. Ignored so an accidental copy can never be
# committed again.
**/oracleJdk*/
**/jdk-*/
**/*.jmod
**/*.jsa

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test fixture PDFs are corpus documents under CC BY-NC-SA. The same
# non-redistribution rule that applies to corpus/ applies here: the
# regression test skips cleanly when the fixture is absent, and
# scripts/fetch_corpus.py can retrieve it.
tests/fixtures/*.pdf

# Transient progress logs
index-progress.log

# The official ADTC profiler is a separate GPL-v3 repository, cloned locally
# for benchmarking. Vendoring it into this MIT-licensed repo would be a licence
# conflict, and committing it as a gitlink would produce a broken checkout.
# Clone it yourself: https://github.com/Africa-Deep-Tech-Foundation/adtc-profiler
profiler/

# Submission bundles contain multi-GB GGUF weights, fetched via models.lock.json
submission*/model/

# The demo video script is a production document, not a deliverable. Gate 1
# asks for the video itself (submitted via DevPost), not the plan for shooting
# it, and the reasoning that matters - measure honestly, never speed up
# generation footage - is recorded in REPORT.md where a judge will read it.
docs/VIDEO_SCRIPT.md
